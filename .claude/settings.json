{
  "permissions": {
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm run lint:fix)",
      "Bash(npm run build:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git ls-files:*)",
      "Bash(git show:*)"
    ],
    "deny": [
      "Read(**/*.env)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.kdbx)",
      "Bash(keepassxc-cli *)",
      "Bash(*keepassxc-cli*)",
      "PowerShell(keepassxc-cli *)",
      "PowerShell(*keepassxc-cli*)"
    ]
  }
}
